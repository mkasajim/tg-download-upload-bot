# --- required ---------------------------------------------------------------

# Get these from https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Phone number of the account used for login (international format, e.g. +8801XXXXXXXXX).
# Optional; if not provided or logged in, you can authenticate via the dashboard or console.
PHONE=

# --- remote database (Turso / LibSQL) ---------------------------------------
# Connects to Turso cloud database so tasks & progress are preserved across VPSs.
# If empty, falls back to local SQLite DB_PATH.
LIBSQL_URL=libsql://tg-download-upload-rachelbasin.aws-ap-south-1.turso.io
LIBSQL_AUTH_TOKEN=

# --- dashboard & server -----------------------------------------------------
# Dashboard admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SECRET_KEY=change_this_to_a_secure_random_key_for_sessions

# Server host and port
HOST=0.0.0.0
PORT=8000

# --- cloudflare tunnel ------------------------------------------------------
# Cloudflare Zero Trust Tunnel token to serve the dashboard securely over HTTPS.
# If previous tunnel instances were running or stopped, the manager cleans them up.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_DOMAIN=

# --- default task settings (optional) ---------------------------------------

# Default source & destination (optional; tasks can be created and run from the dashboard)
SOURCE=@example_channel
DEST=
DEST_TITLE=Video Backup

# Parallel workers per task. Higher = faster, but too high triggers Telegram flood limits.
# 2-5 for home connection; 6-12 on a fast VPS.
WORKERS=3

# Concurrent 512 KiB request stripes used per file while downloading /
# uploading big files.
DL_PARTS=4
UL_PARTS=4

# Paths (relative paths are resolved from the project folder)
DOWNLOAD_DIR=downloads
DB_PATH=progress.db
SESSION_NAME=tg_transfer

# Skip media bigger than this many bytes. Telegram caps uploads from accounts
# without Premium at 2097152000 (2000 MiB); Premium allows 4294967296.
MAX_FILE_SIZE=2097152000

# Attempts per file before it is marked failed.
MAX_ATTEMPTS=3
