# --- required ---------------------------------------------------------------

# Get these from https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# The group/channel to copy videos and photos FROM (an account that is a member of it):
#   @username | https://t.me/username | t.me/c/1234567 link | -1001234567890
SOURCE=@example_channel

# --- destination ------------------------------------------------------------

# Where the media is uploaded. Leave empty to create a new private group
# automatically on the first run (it is remembered in the database and reused).
# Or set it to an existing group/channel you own (@name or numeric id).
DEST=
DEST_TITLE=Video Backup

# --- optional tuning --------------------------------------------------------

# Phone number of the account used for login (international format, e.g. +8801XXXXXXXXX).
# Optional; you will be prompted for it (and the login code) on first run.
PHONE=

# Parallel workers. Each worker downloads, uploads and cleans up one file at
# a time. Higher = faster, but too high triggers Telegram flood limits.
# 2-5 for a home connection; 6-12 on a fast VPS.
WORKERS=3

# Concurrent 512 KiB request stripes used per file while downloading /
# uploading big files. They pipeline over the connection, so more stripes =
# more throughput on fast links. 4 is a good default; raise to 6-8 on a VPS.
DL_PARTS=4
UL_PARTS=4

# Paths (relative paths are resolved from the project folder)
DOWNLOAD_DIR=downloads
DB_PATH=progress.db
SESSION_NAME=tg_transfer

# Skip media bigger than this many bytes. Telegram caps uploads from accounts
# without Premium at 2097152000 (2000 MiB); Premium allows 4294967296.
MAX_FILE_SIZE=2097152000

# Attempts per file before it is marked failed (use --retry-failed to re-queue).
MAX_ATTEMPTS=3
